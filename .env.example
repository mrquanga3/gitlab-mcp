# GitLab MCP Server Configuration
# Rename this file to .env and fill in the values below.

# --- GitLab Configuration ---
# Your GitLab instance URL (e.g., https://gitlab.com or a self-hosted instance)
GITLAB_URL=https://gitlab.com

# Your GitLab Personal Access Token (requires API scope)
# Create one at: GitLab -> User Settings -> Access Tokens
GITLAB_TOKEN=your_gitlab_personal_access_token_here

# --- Optional GitLab Settings ---
# GITLAB_TIMEOUT=30
# GITLAB_LOG_LEVEL=INFO
# GITLAB_VERIFY_SSL=true

# --- Web (HTTP/SSE) Security ---
# Passphrase used to authenticate Claude.ai when connecting over the web.
# Choose a strong password and enter it when Claude.ai pops open the auth screen.
MCP_PASSPHRASE=change-me-pick-a-real-passphrase

# Local port for the MCP HTTP server (to avoid port conflicts, e.g. 8000, 8080, 8500)
MCP_PORT=8500

# --- ngrok multi-MCP setup (optional) ---
# Set when you run multiple MCPs in parallel on ngrok free plan (1 static
# domain per account). Use a different ngrok account than other MCPs use.
# CLI flags --authtoken/--url override ngrok global config -- required to
# avoid ERR_NGROK_334 "endpoint already online" when another MCP owns the
# default static domain of your global-config token.
# GITLAB_NGROK_AUTHTOKEN=2abc...your_gitlab_account_token
# GITLAB_NGROK_DOMAIN=junkman-undrafted-ninja.ngrok-free.dev
